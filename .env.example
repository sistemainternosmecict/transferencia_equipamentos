# ============================================================================
# Configuração de Ambiente — Sistema de Empréstimo e Transferência de Equipamentos
# Secretaria Municipal de Educação, Cultura, Inclusão, Ciência e Tecnologia (SMECICT)
# Prefeitura Municipal de Saquarema - RJ
# ============================================================================

# Ambiente de execução ("development" ou "production")
APP_ENV=development

# Configurações do Servidor HTTP (Granian ASGI)
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true
LOG_LEVEL=INFO

# Segurança e Controle de Acesso
# Origens permitidas no CORS separadas por vírgula (em produção, especifique os domínios internos)
CORS_ORIGINS=*

# Chave de API opcional (se preenchida, exige o cabeçalho HTTP 'X-API-Key' nas rotas de geração de PDF)
# Deixe vazio em desenvolvimento local caso não deseje exigir autenticação por chave.
API_KEY=

# Habilitar documentação interativa (/docs e /redoc)
DOCS_ENABLED=true

# Diretórios de Armazenamento (opcionais — por padrão usam ./pdf e ./public/images na raiz do projeto)
# PDF_OUTPUT_DIR=/home/thyez/Documentos/softwares/transferencia_equipamentos/pdf
# PUBLIC_IMAGES_DIR=/home/thyez/Documentos/softwares/transferencia_equipamentos/public/images
